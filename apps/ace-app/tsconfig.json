{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "preserve",
        "jsxImportSource": "@solidjs/web",
        "types": ["vite/client", "bun"],
        "paths": {
            "$lib": ["./src/lib/index.ts"],
            "$lib/*": ["./src/lib/*"],
            "$engine-client": ["./src/lib/engine-client/index.ts"],
            "$engine-client/*": ["./src/lib/engine-client/*"]
        },
        "allowJs": true,
        "checkJs": false,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "isolatedModules": true,
        "noEmit": true
    },
    "include": [
        "src/**/*",
        "scripts/**/*",
        "vite.config.ts",
        "vitest.config.ts"
    ],
    "exclude": ["node_modules", "build", "src-tauri/target"]
}

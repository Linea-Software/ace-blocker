{
    "name": "ace-app",
    "version": "0.1.0",
    "description": "",
    "type": "module",
    "scripts": {
        "dev": "bun scripts/prepare-linux-auth.ts && vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
        "i18n:audit": "bun scripts/audit-paraglide.ts",
        "check": "bun run i18n:compile && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
        "tauri": "tauri",
        "clear-cache": "bun scripts/clear-cache.ts",
        "test:e2e": "playwright test",
        "test:unit": "vitest run",
        "test": "bun run test:e2e",
        "test:native": "wdio run wdio.conf.ts",
        "auth:register-linux": "bash ../../installer/linux/register-dev-handler.sh"
    },
    "license": "MIT",

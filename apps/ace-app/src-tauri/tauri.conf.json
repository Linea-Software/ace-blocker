{
    "$schema": "https://schema.tauri.app/config/2",
    "app": {
        "security": {
            "csp": null
        },
        "windows": [
            {
                "height": 600,
                "title": "Ace Blocker",
                "width": 800,
                "minWidth": 780,
                "minHeight": 560
            }
        ],
        "withGlobalTauri": true
    },
    "build": {
        "beforeBuildCommand": "bun run build",
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "frontendDist": "../build"
    },
    "bundle": {
        "active": true,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "targets": "all"
    },
    "identifier": "com.lineasoftware.aceapp",
    "plugins": {},
    "productName": "ace-app",
    "version": "0.1.0"
}

{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capability for the main window",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "opener:default",
        "fs:default",
        "fs:allow-mkdir",
        "fs:allow-write-text-file",
        {
            "identifier": "fs:scope",
            "allow": [
                "$APPLOCALDATA",
                "$APPLOCALDATA/**"
            ]
        },
        "log:default",
        "store:default",
        "dialog:default",
        {
            "identifier": "opener:allow-open-url",
            "allow": [
                {
                    "url": "aceblocker:*"
                },
                {
                    "url": "https://*"
                }
            ]
        },
        "wdio:default",
        "wdio-webdriver:default"
    ]
}
